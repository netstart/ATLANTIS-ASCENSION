+    fun loadTopScores100(
+        leaderboardId: String,
+        timeSpan: Int,
+        collection: Int,
+        forceReload: Boolean
+    ) {
+        leaderboardsClient.loadTopScores(leaderboardId, timeSpan, collection, 25, forceReload)
+            .addOnSuccessListener { task ->
+                val first = task.get()!!
+                val leaderboard: Dictionary? = first.leaderboard?.let { fromLeaderboard(godot, it) }
+                accumulateTopScores(leaderboardId, first, leaderboard, ArrayList(), 1)
+            }
+            .addOnFailureListener { error ->
+                Log.e(tag, "Failed to load top scores for leaderboard $leaderboardId", error)
+                emitSignal(godot, BuildConfig.GODOT_PLUGIN_NAME, topScoresLoaded, leaderboardId, Gson().toJson(null))
+            }
+    }
+
+    // Google's loadMoreScores delivers every page in its own windowed buffer, so we copy each page's
+    // rows into [accumulated] and concatenate, instead of emitting a single page. We walk forward until
+    // we hold 100 rows, a page comes back short (the leaderboard ended), or we reach the four-page cap.
+    // Rows are kept only when their rank advances, guarding against a repeated or overlapping page.
+    private fun accumulateTopScores(
+        leaderboardId: String,
+        scores: LeaderboardsClient.LeaderboardScores,
+        leaderboard: Dictionary?,
+        accumulated: MutableList<Dictionary>,
+        page: Int
+    ) {
+        val buffer = scores.scores
+        val pageCount = buffer.count
+        for (score in buffer) {
+            val lastRank = (accumulated.lastOrNull()?.get("rank") as? Long) ?: 0L
+            if (score.rank <= lastRank) continue
+            accumulated.add(fromLeaderboardScore(godot, score))
+            if (accumulated.size >= 100) break
+        }
+        if (accumulated.size >= 100 || pageCount < 25 || page >= 4) {
+            emitTopScores(leaderboardId, leaderboard, accumulated)
+            scores.release()
+            return
+        }
+        leaderboardsClient.loadMoreScores(buffer, 25, PageDirection.NEXT)
+            .addOnSuccessListener { task ->
+                val next = task.get()!!
+                scores.release()
+                accumulateTopScores(leaderboardId, next, leaderboard, accumulated, page + 1)
+            }
+            .addOnFailureListener { error ->
+                Log.e(tag, "Failed to load next top scores page for leaderboard $leaderboardId", error)
+                emitTopScores(leaderboardId, leaderboard, accumulated)
+                scores.release()
+            }
+    }
+
+    private fun emitTopScores(
+        leaderboardId: String,
+        leaderboard: Dictionary?,
+        accumulated: List<Dictionary>
+    ) {
+        val result = Dictionary()
+        leaderboard?.let { result["leaderboard"] = it }
+        result["scores"] = accumulated.take(100)
+        emitSignal(godot, BuildConfig.GODOT_PLUGIN_NAME, topScoresLoaded, leaderboardId, Gson().toJson(result))
+    }
+}
